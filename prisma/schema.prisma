// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MASTER
  SECRETARY
  DOCTOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                      String            @id @default(cuid())
  name                    String?
  email                   String?           @unique
  emailVerified           DateTime?         @map("email_verified")
  image                   String?
  passwordHash            String?           @map("password_hash") @db.Text
  cpf                     String?           @unique
  phone                   String?
  birthDate               DateTime?         @map("birth_date")
  gender                  String?
  role                    Role              @default(SECRETARY)
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at")
  accounts                Account[]
  sessions                Session[]
  doctorProfile           DoctorProfile?
  secretaryProfile        SecretaryProfile?
  appointmentsAsDoctor    Appointment[]     @relation("DoctorAppointments")
  appointmentsAsSecretary Appointment[]     @relation("SecretaryAppointments")
  patients                Patient[]

  @@map("users")
}

model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crm            String   @unique
  crmUf          String   @map("crm_uf")
  specialties    String[]
  bio            String?  @db.Text
  workDays       String[] @default([]) @map("work_days")
  startMorning   String?  @map("start_morning")
  endMorning     String?  @map("end_morning")
  startAfternoon String?  @map("start_afternoon")
  endAfternoon   String?  @map("end_afternoon")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("doctor_profiles")
}

model SecretaryProfile {
  id           String  @id @default(cuid())
  userId       String  @unique @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration String? @unique

  @@map("secretary_profiles")
}

model Patient {
  id             String        @id @default(cuid())
  fullName       String        @map("full_name")
  cpf            String?       @unique
  phone          String?
  email          String?
  birthDate      DateTime?     @map("birth_date")
  gender         String?
  address        String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  registeredById String        @map("registered_by_id")
  registeredBy   User          @relation(fields: [registeredById], references: [id])
  appointments   Appointment[]

  @@map("patients")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String            @map("doctor_id")
  doctor          User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  secretaryId     String            @map("secretary_id")
  secretary       User              @relation("SecretaryAppointments", fields: [secretaryId], references: [id], onDelete: Cascade)
  dateTime        DateTime          @map("date_time")
  durationMinutes Int               @default(30) @map("duration_minutes")
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([doctorId, dateTime])
  @@index([patientId])
  @@map("appointments")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
